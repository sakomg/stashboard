{
  "name": "stashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, read-only portfolio dashboard for Binance, EVM, Solana, TON and DeFi",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "auth": "node --disable-warning=ExperimentalWarning src/auth-setup.ts",
    "check": "node --disable-warning=ExperimentalWarning src/check.ts",
    "collect": "node --disable-warning=ExperimentalWarning src/collect.ts",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "wallets": "node --disable-warning=ExperimentalWarning src/wallets.ts",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "echarts": "6.1.0",
    "fastify": "5.12.8",
    "qrcode-terminal": "0.12.0"
  }
}
