{
  "name": "stashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, read-only portfolio dashboard for Binance, Bybit, OKX, EVM, Solana, TON and DeFi",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "demo": "node --disable-warning=ExperimentalWarning src/cli/demo.ts",
    "auth:reset": "node --disable-warning=ExperimentalWarning src/cli/auth-reset.ts",
    "check": "node --disable-warning=ExperimentalWarning src/cli/check.ts",
    "collect": "node --disable-warning=ExperimentalWarning src/cli/collect.ts",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "wallets": "node --disable-warning=ExperimentalWarning src/cli/wallets.ts",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "echarts": "6.1.0",
    "fastify": "5.12.8",
    "lucide-static": "1.73.0",
    "qrcode-generator": "2.0.4"
  }
}
